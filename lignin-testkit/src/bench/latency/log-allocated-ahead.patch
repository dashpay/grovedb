--- a/lignin-io/src/vfs.rs
+++ b/lignin-io/src/vfs.rs
@@ -501,6 +501,16 @@ pub trait VfsFile: Any + fmt::Debug + Send + Sync {
     ///
     /// Needs [`OpenMode::Write`] or [`OpenMode::Append`].
     fn set_len(&self, len: u64) -> io::Result<()>;
+
+    /// EXPERIMENT (PERF-07-F1): has storage set aside for the file up to
+    /// `len` bytes, so that an append below that length extends nothing.
+    /// What [`Self::len`] of this handle answers and where its next
+    /// append lands are unchanged. Another handle of the file can find it
+    /// `len` bytes long, with zeros behind what was appended.
+    fn allocate(&self, len: u64) -> io::Result<()> {
+        let _ = len;
+        Ok(())
+    }
 }
 
